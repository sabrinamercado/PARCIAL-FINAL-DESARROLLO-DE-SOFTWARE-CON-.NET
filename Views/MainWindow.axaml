<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BibliotecaPersonal.Views.MainWindow"
        Title="Biblioteca Personal" Width="760" Height="560">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="📚 Mi Biblioteca Personal" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

    <Grid Grid.Row="1" ColumnDefinitions="90,*,90,*" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Título:" VerticalAlignment="Center"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtTitulo" Margin="0,0,12,6"/>
      <TextBlock Grid.Row="0" Grid.Column="2" Text="Autor:" VerticalAlignment="Center"/>
      <TextBox   Grid.Row="0" Grid.Column="3" x:Name="TxtAutor" Margin="0,0,0,6"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Año:" VerticalAlignment="Center"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtAnio" Margin="0,0,12,0"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="Estado:" VerticalAlignment="Center"/>
      <ComboBox  Grid.Row="1" Grid.Column="3" x:Name="CmbEstado" HorizontalAlignment="Stretch"/>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="Guardar nuevo" Click="Guardar_Click"/>
      <Button Content="Actualizar seleccionado" Click="Actualizar_Click"/>
      <Button Content="Eliminar seleccionado" Click="Eliminar_Click"/>
      <Button Content="Limpiar" Click="Limpiar_Click"/>
    </StackPanel>

    <ListBox Grid.Row="3" x:Name="LstLibros" SelectionChanged="Lista_SelectionChanged"/>

    <TextBlock Grid.Row="4" x:Name="TxtMensaje" Margin="0,8,0,0" FontWeight="SemiBold"/>
  </Grid>
</Window>
